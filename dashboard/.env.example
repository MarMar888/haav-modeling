# Copy to .env.local and fill in. Never commit the real file.
#
# Local Postgres:   postgres://<your-user>@localhost:5432/hav_bom
# Neon (preferred): `neon link --project-id tiny-sunset-56470675 --branch production -y`
#                   writes DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED here for you.
DATABASE_URL=

# Sponsor form notifications (Resend). Set both to get an email on every submission.
# With Resend's default sender, NOTIFY_EMAIL must be the address that owns the Resend account.
RESEND_API_KEY=
NOTIFY_EMAIL=
# RESEND_FROM="Haav <hello@your-verified-domain.com>"   # only once a domain is verified in Resend

# The newsletter (/admin) uses RESEND_API_KEY above. Its other settings (passcode, sender, preview address) are in
# src/lib/newsletter-config.ts.
