# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# root package.json only delegates into dashboard/ - no real deps to lock
/node_modules
/pnpm-lock.yaml

# misc
.DS_Store
*.pem

# env files (can opt-in for committing if needed)
.env*

# gstack
.gstack/

# universal agent-skills mirror; .claude/skills/ is the committed copy
/.agents/

# CAD: the Python env and everything agentcad generates. Source lives in
# cad/hull.py; rebuild with `agentcad run hull.py` (see README).
/.venv-cad/
/hull/geometry/legacy-parametric/build/

# OpenFOAM decomposed solver output (hundreds of MB); regenerate with the case run scripts
hull/hydrodynamics-cfd/**/processor*/

.venv/
__pycache__/
.pytest_cache/
runs/
.ipynb_checkpoints/
.mpl-cache/

# Isolated hydrostatics dependency environment
/hull/hydrostatics/.venv/

# CFD work is kept locally and excluded from publication
/hull/hydrodynamics-cfd/
